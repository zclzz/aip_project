# Copy to .env and edit. Every variable is optional.

# Shared secret clients must send as X-API-Key (or Authorization: Bearer).
# Leave empty to have the server generate one at startup (printed in the logs).
API_KEY=change-me-to-something-long-and-random

# auto (GPU if present, else CPU) | cuda | cpu
DEVICE=auto

# Host port to publish
PORT=8010

# Limits
RATE_LIMIT_PER_MINUTE=30
MAX_TEXT_CHARS=1000
MAX_UPLOAD_MB=10
MAX_REFERENCE_SECONDS=30

# Comma-separated browser origins allowed to call the API cross-site (empty = same-origin only)
CORS_ORIGINS=
